{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "diagnostics",
  "description": "Read-only diagnostics for advanced settings: app paths and logs. No shell execution.",
  "windows": ["main"],
  "permissions": [
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/IELTS Practice/logs/**" },
        { "path": "$APPDATA/IELTS Practice/diagnostics/**" }
      ]
    }
  ]
}
