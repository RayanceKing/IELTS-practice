{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "data-transfer",
  "description": "User-triggered import/export dialogs only. Paths must still be validated in Rust commands.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/IELTS Practice/exports/**" },
        { "path": "$APPDATA/IELTS Practice/imports/**" },
        { "path": "$APPDATA/IELTS Practice/backups/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" }
      ]
    }
  ]
}
