{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "library",
  "description": "Scoped library/asset directory discovery. Does not allow arbitrary disk traversal.",
  "windows": ["main"],
  "permissions": [
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/IELTS Practice/**" },
        { "path": "$APPDATA/ielts-practice/**" },
        { "path": "$RESOURCE/**" }
      ]
    }
  ]
}
